<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="24dp">

            <com.cdcb.samanthapp.OrbView
                android:id="@+id/orb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/status_idle"
                android:focusable="true" />

            <TextView
                android:id="@+id/transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:ellipsize="end"
                android:maxLines="5"
                android:minHeight="56dp"
                android:padding="16dp"
                android:text="@string/transcript_placeholder"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:visibility="gone" />

            <com.cdcb.samanthapp.MaxHeightScrollView
                android:id="@+id/responseScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:fadeScrollbars="false"
                android:scrollbars="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/response"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="@color/cyan"
                    android:textSize="16sp" />

            </com.cdcb.samanthapp.MaxHeightScrollView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_title"
        android:padding="12dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/text_muted" />

</FrameLayout>
